{
  "name": "FOLLOW/BACK - Instagram follow-back checker",
  "short_name": "FOLLOW/BACK",
  "description": "See who does not follow you back on Instagram. Reads your own data export locally. No login, no upload, no network requests.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#f4efe6",
  "theme_color": "#f4efe6",
  "icons": [
    {
      "src": "icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "files",
          "accept": [
            "application/zip",
            "application/x-zip-compressed",
            ".zip",
            "application/json",
            ".json",
            "text/html",
            ".html"
          ]
        }
      ]
    }
  }
}
